# PatchBound Environment Settings
# LLM Providers (At least one required for autonomous reasoning; deterministic mode works without keys)
PATCHBOUND_ANTHROPIC_API_KEY=
PATCHBOUND_GEMINI_API_KEY=
PATCHBOUND_OPENAI_API_KEY=

# GitHub Authentication (gh CLI keyring is preferred; or personal access token)
GITHUB_TOKEN=

# Model Routing
PATCHBOUND_MODEL_FAST=gemini-1.5-flash
PATCHBOUND_MODEL_STRONG=claude-3-7-sonnet-20250219
PATCHBOUND_MODEL_REVIEWER=claude-3-5-sonnet-20241022

# Operational Budgets
PATCHBOUND_MAX_RETRIES=2
PATCHBOUND_TIMEOUT_SECONDS_PER_TEST=120
PATCHBOUND_AUTO_APPROVE=true
